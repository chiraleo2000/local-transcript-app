# Tesla P4 host overlay — maximize accuracy + performance on 7.5 GB VRAM.
# Applied via deploy/docker/compose.tesla-p4.yml.
#
# ASR: faster-whisper CT2 (wired in typhoon_asr.py) + turn batching.
# Diarization: CUDA after ASR staging + meeting309-validated accuracy knobs.

APP_VERSION=1.2.13-p4-opt
APP_FORCE_BACKEND=cuda
APP_CPU_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
MIN_SYSTEM_RAM_MB=7000
MIN_NVIDIA_VRAM_MB=6000
OV_DEVICE=CPU

# PyTorch fallback only when CT2 unavailable — stay under ~6 GB
ASR_GPU_PROFILE=off
ASR_CUDA_DTYPE=float16
ASR_ATTENTION_IMPLEMENTATION=sdpa
ASR_CUDA_MEMORY_FRACTION=0.85
ASR_CUDA_MEMORY_FRACTION_MAX=0.85
ASR_HARD_MEMORY_SAFE=true

# CT2 primary path (int8 ~2 GB load vs PyTorch ~6 GB)
ASR_USE_FASTER_WHISPER=true
ASR_CT2_COMPUTE_TYPE=int8_float32
ASR_CT2_REQUIRE_OK_MARKER=true
ASR_CT2_BATCHED_MIN_DURATION_S=30
ASR_NUM_BEAMS=3
ASR_NUM_BEAMS_MAX=3
ASR_NUM_BEAMS_MIN=2
ASR_TEMPERATURE=0.0,0.2,0.4
ASR_CUDA_BATCH_SIZE=4
ASR_8GB_BATCH_SIZE=4
ASR_8GB_MAX_BATCH_SIZE=4
ASR_TURN_BATCH_SIZE=4
ASR_MAX_CONCURRENT_INFERENCE=1
ASR_PARALLEL_MODE=sequential
ASR_ALLOW_8GB_PARALLEL=false
ASR_ADAPTIVE_PERFORMANCE=true
ASR_BUDGET_SEC_PER_TURN=6
ASR_FAST_MODE=true
ASR_QUALITY_PROFILE=high

# Turn-guided accuracy
ASR_TURN_GUIDED=true
ASR_TURN_USE_DIAR_TIMESTAMPS=true
ASR_TURN_GUIDED_MAX_TURN_S=26
ASR_TURN_GUIDED_MERGE_GAP_S=0.45
ASR_TURN_GUIDED_MIN_TURN_S=0.2
ASR_TURN_GUIDED_MAX_DURATION_S=86400
ASR_TURN_PAD_S=0.20
ASR_TURN_BOUNDARY_TRIM_S=0.0
ASR_TURN_BOUNDARY_MARGIN_S=0.04
ASR_TURN_OUTPUT_MERGE_GAP_S=0.0
ASR_WORD_TIMESTAMPS_WITH_DIARIZATION=false
ASR_CONDITION_ON_PREVIOUS_TEXT=false
ASR_SUPPRESS_HALLUCINATIONS=true
ASR_REJECT_HALLUCINATED_TURNS=true
ASR_LOGPROB_THRESHOLD=-0.5
ASR_COMPRESSION_RATIO_THRESHOLD=2.4
ASR_NO_SPEECH_THRESHOLD=0.6
ASR_NO_REPEAT_NGRAM_SIZE=8
ASR_REPETITION_PENALTY=1.0
ASR_CLEANUP_THAI_SPACING=true

# Keep CT2 warm between jobs (~2 GB — safe on P4)
ASR_KEEP_PRELOADED=true
ASR_PRELOAD_MODE=lazy
ASR_CLEAR_VRAM_AFTER_JOB=false
ASR_CLEAR_VRAM_BETWEEN_ENGINES=true
ASR_CLEAR_VRAM_ON_MEDIA_CHANGE=true
ASR_UNLOAD_FOR_DIARIZATION=true
ASR_UNLOAD_ON_CANCEL=true

# Diarization: CUDA + accuracy (meeting309 / cal15 lock)
DIARIZATION_ACCURACY_MODE=true
DIARIZATION_DEVICE=cuda
DIARIZATION_REQUIRE_CUDA=1
DIARIZATION_ALLOW_8GB_CUDA=true
DIARIZATION_PRELOAD_DEVICE=cuda
DIARIZATION_PRELOAD_MODE=lazy
DIARIZATION_KEEP_PRELOADED=false
DIARIZATION_GPU_CO_RESIDENT=false
DIARIZATION_CUDA_MIN_VRAM_MB=4500
DIARIZATION_CUDA_MIN_FREE_MB=768
DIARIZATION_CUDA_RUN_MIN_FREE_MB=512
DIARIZATION_SEGMENTATION_THRESHOLD=0.31
DIARIZATION_CLUSTERING_THRESHOLD=0.38
DIARIZATION_MIN_DURATION_OFF=0.02
DIARIZATION_OVERCLUSTER_EXTRA=5
DIARIZATION_CENTROID_MERGE_THRESHOLD=0
DIARIZATION_VBX_FA=0.25
DIARIZATION_VBX_FB=0.8
DIARIZATION_BRIEF_RESCUE_MAX_SPAN_S=8
DIARIZATION_INTRO_RECOVERY=true
DIARIZATION_INTRO_RECOVERY_SPAN_S=360
DIARIZATION_MEGA_TURN_MAX_REFINES=2
DIARIZATION_MEGA_TURN_RETRY_S=35
DIARIZATION_DOMINANCE_RETRY_RATIO=0.72
DIARIZATION_MIN_OVERLAP_S=0.06
DIARIZATION_MULTI_SAMPLE=false
DIARIZATION_MULTI_SAMPLE_PASSES=0

AUDIO_ENHANCE_USE_GPU=false
AUDIO_ENHANCE_DEFAULT=true
AUDIO_ENHANCE_WHEN_DIARIZATION=false
AUDIO_ENHANCE_ASR_ONLY=true
AUDIO_ENHANCE_NOISE_REDUCTION=0.35

UI_MAX_CONCURRENT_JOBS=1
UI_GRADIO_TRANSCRIBE_CONCURRENCY=8
UI_QUEUE_MAX_SIZE=64
UI_PROGRESS_POLL_S=0.35
API_MAX_QUEUED_JOBS=4
UI_PREVIEW_MAX_MB=8
UI_PREVIEW_MAX_DURATION_S=60
APP_SESSION_TTL_S=14400
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:32
