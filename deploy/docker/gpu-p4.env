# Tesla P4 / Pascal overlay (compute capability 6.1).
#
# CUDA 13 (deploy/docker/latest) dropped sm_61 — use the cuda124 stack:
#   Deploy-Docker.bat gpu -CudaStack cuda124 -Build
#
# Runtime also auto-applies these knobs when it sees a Tesla P4 / Pascal GPU
# (backend/gpu_arch.py). This file is the documented overlay if you want to
# force the profile without detection: copy values into .env or pass
# ASR_GPU_PROFILE=p4.
#
# Goal vs RTX 4060: keep turn-guided accuracy, cut wall time (2 beams, FP32,
# shorter temperature ladder, fewer tiny ASR turns). P4 cannot match 4060
# Tensor-core FP16; this is the closest practical path.

ASR_GPU_PROFILE=p4
ASR_CUDA_DTYPE=float32
ASR_ATTENTION_IMPLEMENTATION=eager
ASR_NUM_BEAMS=2
ASR_NUM_BEAMS_MAX=2
ASR_NUM_BEAMS_MIN=1
ASR_TEMPERATURE=0.0,0.2,0.4
ASR_TURN_GUIDED=true
ASR_TURN_GUIDED_MAX_TURN_S=28
ASR_TURN_GUIDED_MERGE_GAP_S=0.55
ASR_ADAPTIVE_PERFORMANCE=true
ASR_BUDGET_SEC_PER_TURN=8
ASR_CUDA_MEMORY_FRACTION=0.90
ASR_UNLOAD_FOR_DIARIZATION=true
DIARIZATION_PRELOAD_DEVICE=cpu
DIARIZATION_GPU_CO_RESIDENT=false
DIARIZATION_MEGA_TURN_MAX_REFINES=1
DIARIZATION_MULTI_SAMPLE=false
DIARIZATION_MULTI_SAMPLE_PASSES=0
AUDIO_ENHANCE_USE_GPU=false
